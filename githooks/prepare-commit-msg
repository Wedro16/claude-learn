#!/usr/bin/env python3
"""Add Claude provenance trailers and stage the attribution note. Never blocks a commit."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

try:
    from learner.gitflow import prepare_commit_msg

    prepare_commit_msg(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else None)
except Exception as exc:  # provenance must never stop someone committing
    print(f"claude-learn: attribution skipped ({exc})", file=sys.stderr)
